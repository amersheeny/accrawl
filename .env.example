# Accrawl secrets — copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Generate each random value with the command shown next to it.
#
# NOTE: there is NO admin password here. You set the operator password on FIRST LAUNCH, in the web
# console's setup screen (http://localhost:8088) — it is stored only as an argon2id hash, never in a file.
#
# Out-of-tree secrets (recommended): instead of putting a value here, you may keep any secret in a file
# OUTSIDE the repo and point Accrawl at it with the `_FILE` convention — e.g. set CREDENTIAL_ENC_KEY_FILE
# to a path mounted as a Docker secret. See docker-compose.yml's `secrets:` block and DEPLOY.md. A
# file-mounted secret never appears in `docker inspect`, `/proc/<pid>/environ`, or git.

# Postgres superuser password (the control-plane's privileged DB role).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Least-privilege engine DB role password. The engine connects as `accrawl_engine`, which can touch
# ONLY session telemetry + staging rows — never credentials or your financial data.
#   openssl rand -hex 24
ENGINE_DB_PASSWORD=

# Bearer the control-plane sends to the engine. Defense-in-depth behind the engine not being
# host-published. (Supports ENGINE_SHARED_SECRET_FILE.) Also the HKDF root for the device-proxy tunnel token.
#   openssl rand -hex 32
ENGINE_SHARED_SECRET=

# OPTIONAL — only if you use the device-proxy tunnel (an institution with useDeviceProxy, relayed by the
# companion phone for a residential exit IP). The public WebSocket URL the phone connects to: the Caddy
# /tunnel route in front of the engine, e.g. wss://your-host:8088/tunnel (ws:// for plain local HTTP).
# Leave empty to keep the device proxy off.
ENGINE_WS_URL=

# AES-256-GCM master key that encrypts your bank credentials at rest. EXACTLY 64 hex chars (32 bytes).
# Set ONCE — changing it strands all previously-encrypted credentials. (Supports CREDENTIAL_ENC_KEY_FILE.)
#   openssl rand -hex 32
CREDENTIAL_ENC_KEY=

# Proves whoever sets the first password is the person who installed this deployment. setup.sh generates
# it and shows it to you; enter it once, with your password, on the first-run screen. Until that password
# exists the deployment belongs to nobody, and a deployment with a domain must be reachable to obtain a
# certificate — so without this, whoever reaches it first can claim it permanently. Supports
# SETUP_CLAIM_TOKEN_FILE. Rotate by changing it and restarting; it does nothing once setup is complete.
SETUP_CLAIM_TOKEN=

# OPTIONAL — validity of newly issued operator session tokens, in hours. Default 168 (seven days);
# minimum 1, maximum 720. Keep 168 when you sign in only from devices you control. Do not sign in
# from a shared or untrusted machine; if that is unavoidable, set 1 and revoke every session
# immediately afterwards. A shorter lifetime limits how long a copied token can be reused; it does
# not make an untrusted machine safe, and it does not change the expiry of tokens already issued.
# To end every current session, POST /api/auth/revoke-all with the operator password — that rotates
# the signing secret, and DEPLOY.md shows the exact command. An invalid or out-of-range value here
# is ignored in favour of 168 rather than stopping the deployment from starting.
OPERATOR_TOKEN_TTL_HOURS=

# Google Gemini API key — the crawl LLM. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL — model used by the write gate to classify an unrecognised state-changing request as a
# data read or a state change. Only ever sees a method, path and parameter names; never page content.
# Leave unset for the default (gemini-2.5-flash-lite). With no model reachable the gate still works,
# and simply refuses every state-changing request once login has completed.
#REQUEST_VET_MODEL=

# OPTIONAL — required for event-driven Companion wake-ups in a self-hosted deployment. Android delivers
# a background wake through its platform push service, so one push project serves both sides: the
# Companion registers with it, and this server sends through it. DEPLOY.md walks through creating one and
# granting a dedicated sender identity the single permission it needs.
COMPANION_PUSH_PROJECT_ID=

# Path INSIDE the control-plane container to that sender identity's key. Mount it read-only as a Docker
# secret; DEPLOY.md includes a docker-compose.override.yml example. Leave both settings empty when Companion
# is not used.
COMPANION_PUSH_CREDENTIALS_FILE=

# What a paired Companion registers with, handed to it after pairing so one published build works against
# any deployment. All four or none: a partial set lets the app register somewhere this server cannot reach,
# which shows up as a phone that never wakes rather than as an error. Read them from your push project's
# Android client configuration. None is a secret — every app that embeds them exposes them.
COMPANION_PUSH_CLIENT_APP_ID=
COMPANION_PUSH_CLIENT_API_KEY=
COMPANION_PUSH_CLIENT_SENDER_ID=

# ── Networking (all OPTIONAL — sensible defaults; managed by ./setup.sh and ./accrawl) ─────────────────
# These only affect the HOST publish side. The internal container port is always 8088.

# Host port the console is published on (http://localhost:<port> in local mode). Default 8088.
#   Change it any time with:  ./accrawl set-port <n>
ACCRAWL_PORT=8088

# Host interface the port binds to. Default 127.0.0.1 = localhost ONLY (secure by default — not reachable
# from other machines). Set to 0.0.0.0 to allow access from other devices on your LAN (front it with TLS
# first — see ACCRAWL_DOMAIN / DEPLOY.md). Only 127.0.0.1 and 0.0.0.0 are accepted.
#   Change it any time with:  ./accrawl set-bind <addr>
ACCRAWL_BIND=127.0.0.1

# Public domain for remote access with automatic HTTPS. Leave EMPTY for local/plain-HTTP mode (the default).
# When set, Caddy serves this host on :80/:443 with a real Let's Encrypt certificate (ACME) instead of plain
# :8088 — ./accrawl and setup.sh switch to the TLS compose overlay automatically. Requires this domain's DNS
# to point at THIS host and ports 80+443 to be internet-reachable.
#   e.g. ACCRAWL_DOMAIN=accrawl.example.com
ACCRAWL_DOMAIN=

# Optional ACME account email (Let's Encrypt expiry-notice emails). Only used when ACCRAWL_DOMAIN is set;
# empty is fine (certs still issue, just without notice emails).
ACCRAWL_TLS_EMAIL=

# Where this deployment publishes the Companion app, if it publishes one. The console offers a download
# and a QR that point at this deployment's own domain; the reverse proxy streams the object from the
# origin named here, preserving resumable downloads. Build the app with `./accrawl companion build`.
#
# Leave both unset and the download route is not served — which is the right default: an unset origin
# should give a reader nothing rather than somebody else's copy of a financial app.
COMPANION_APK_UPSTREAM=
COMPANION_APK_PATH=
