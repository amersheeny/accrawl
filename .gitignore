# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local run artifacts (session telemetry, screenshots, logs from PLATFORM=local)
runs/

# Secrets / local config
.env
.env.local
.env.*.local

# Generated by `./accrawl install-service` (host-specific boot unit) — never commit it.
infra/accrawl.service

# Logs
*.log
logs/

# OS / editor
.DS_Store
.vscode/
.idea/

# Turborepo cache
.turbo/
apps/web/dist

# tesseract.js OCR language data (downloaded at runtime by the e2e leak scan)
*.traineddata

# Credential files that must never be committed or copied into an image.
service-account.json
*credentials*.json
*-service-account*.json
