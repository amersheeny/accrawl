# ─── Accrawl configuration ──────────────────────────────────────────────────
# Copy to .env and fill in. The only REQUIRED value for a local run is GEMINI_API_KEY.

# ── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                  # Google AI Studio key — the only LLM key used

# ── Platform (where the crawl's telemetry and results go) ───────────────────
# local    = filesystem run artifacts, file-based OTP, plaintext credentials (default).
# postgres = the self-host control plane's database, under a least-privilege role.
# remote   = a one-shot worker with no persistence of its own, talking to the control plane's broker.
# A deployment can register others and select them by name here.
PLATFORM=local
RUNS_DIR=./runs                  # where PLATFORM=local writes session.json / step-*.jpg / logs

# ── Service shape ───────────────────────────────────────────────────────────
SERVICE_MODE=development         # crawl | tunnel | development (all routes; local dev)
SERVICE_NAME=accrawl
PORT=8080
NODE_ENV=development             # in production, token mode also requires CRAWLER_AUDIENCE
HEADLESS=true                    # false to watch the browser locally

# ── Who may call /crawl and /cancel ─────────────────────────────────────────
# Unset, the mode is inferred: a shared secret means shared-secret, an audience means token,
# neither means none. See apps/engine/README.md.
ENGINE_INBOUND_AUTH=             # token | shared-secret | none
ENGINE_SHARED_SECRET=            # shared-secret mode: the bearer the control plane sends
CRAWLER_AUDIENCE=                # token mode: this service's URL; MANDATORY when NODE_ENV=production
OIDC_ISSUER=                     # token mode: the issuer whose tokens are accepted
OIDC_JWKS_URL=                   # token mode: where its keys are, if it publishes no discovery document
ENGINE_ALLOWED_CALLER=           # optional: pin the accepted caller's identity (was CRAWLER_INVOKER_SA)

# ── Crawler tuning (optional; sensible defaults in code) ────────────────────
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=
USE_INTERACTIONS_API=true
MAX_INFO_CALLS_PER_STEP=
GEMINI_REQUEST_TIMEOUT_MS=
INITIAL_NAV_TIMEOUT_MS=
SCREENSHOT_TIMEOUT_MS=
CAPTURE_TIMEOUT_MS=
WATCHDOG_GRACE_MS=
